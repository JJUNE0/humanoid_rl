{
  "version": 1,
  "name": "light_supermimic_lafan_all",
  "method": "supermimic",
  "task": "Humanoid-Light-Motion-Tracking",
  "robot": "humanoid_light",
  "description": "Full LAFAN1 (64 sequences, 668k frames, 1888 clips) optimal RTX 3090 config (5,239 steps/s, 10GB free VRAM, exact UTD=16)",
  "config": {
    "training": {
      "num_envs": 2048,
      "total_env_steps": 65536000,
      "warmup_steps": 32,
      "updates_per_step": 1,
      "save_every": 4096000,
      "log_every": 25,
      "compile": true,
      "cuda_graphs": true,
      "muon_dtype": "bfloat16",
      "buffer_size": 512
    },
    "motion": {
      "manifest": "${data_root}/configs/motions/light_supermimic_lafan_all.json"
    },
    "environment": {
      "action_mode": "coupled_scale",
      "action_scale": 0.25,
      "key_bodies_only": true
    },
    "runner": {
      "sampling_mode": "return",
      "dynamics_hidden_dims": [1024, 1024, 1024],
      "actor_hidden_dims": [1024, 1024, 512, 256],
      "critic_hidden_dims": [512, 256],
      "wm": {
        "num_batches": 2,
        "batch_size": 2048,
        "horizon": 8
      },
      "policy": {
        "num_batches": 1,
        "batch_size": 2048,
        "horizon": 32
      }
    }
  },
  "inputs": []
}
