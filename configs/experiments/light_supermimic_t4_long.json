{
  "version": 1,
  "name": "light_supermimic_t4_long",
  "method": "supermimic",
  "task": "Humanoid-Light-Motion-Tracking",
  "robot": "humanoid_light",
  "description": "Resume the trained T4 policy to 2,048,000 transitions after comparing simulator/learner throughput",
  "config": {
    "training": {"total_env_steps": 2048000, "save_every": 65536, "log_every": 10},
    "motion": {"manifest": "${data_root}/configs/motions/light_supermimic_t4_trial.json"}
  },
  "inputs": [
    {"path": "${data_root}/outputs/humanoid_light_bfm/manifest.json", "kind": "file"}
  ]
}
