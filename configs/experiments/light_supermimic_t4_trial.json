{
  "version": 1,
  "name": "light_supermimic_t4_trial",
  "method": "supermimic",
  "task": "Humanoid-Light-Motion-Tracking",
  "robot": "humanoid_light",
  "description": "Free T4 trial: 20 screened CMU/LAFAN training trajectories, original network sizes, 51,200 transitions",
  "config": {
    "training": {"total_env_steps": 51200, "save_every": 6400, "log_every": 25},
    "motion": {"manifest": "${data_root}/configs/motions/light_supermimic_t4_trial.json"}
  },
  "inputs": [
    {"path": "${data_root}/outputs/humanoid_light_bfm/manifest.json", "kind": "file"}
  ]
}
