{
  "version": 1,
  "name": "light_supermimic_run_soft",
  "method": "supermimic",
  "task": "Humanoid-Light-Motion-Tracking",
  "robot": "humanoid_light",
  "description": "Soft-footstep BPTT fine-tuning on LAFAN1 running & sprinting (Impact + Slip + Leg smoothness) warm-started from Stage-2 65.5M policy",
  "config": {
    "training": {
      "init_from": "${data_root}/runs/light_supermimic_lafan_all/rtx3090_lafan_all_stage2_20261118/training/checkpoints/step_65536000",
      "num_envs": 2048,
      "total_env_steps": 10240000,
      "warmup_steps": 32,
      "updates_per_step": 1,
      "save_every": 2048000,
      "log_every": 25,
      "compile": true,
      "cuda_graphs": true,
      "muon_dtype": "bfloat16",
      "buffer_size": 512
    },
    "motion": {
      "manifest": "${data_root}/src/humanoid_retarget/configs/motions/light_supermimic_run.json"
    },
    "environment": {
      "action_mode": "coupled_scale",
      "action_scale": 0.25,
      "key_bodies_only": true,
      "soft_footstep": {
        "enabled": true,
        "impact_weight": 2.0,
        "v_free": 0.15,
        "impact_height": 0.050,
        "impact_tau": 0.012,
        "slip_weight": 0.15,
        "slip_height": 0.010,
        "slip_tau": 0.004,
        "leg_action_rate_weight": 0.10
      }
    },
    "runner": {
      "sampling_mode": "return",
      "dynamics_hidden_dims": [1024, 1024, 1024],
      "actor_hidden_dims": [1024, 1024, 512, 256],
      "critic_hidden_dims": [512, 256],
      "wm": {
        "num_batches": 2,
        "batch_size": 2048,
        "horizon": 8
      },
      "policy": {
        "lr": 0.0001,
        "num_batches": 1,
        "batch_size": 2048,
        "horizon": 32
      }
    }
  },
  "inputs": []
}
