{
  "version": 1,
  "name": "light_supermimic_s2r_full",
  "method": "supermimic",
  "task": "Humanoid-Light-Motion-Tracking",
  "robot": "humanoid_light",
  "description": "Sim-to-Real generalist foundation model from scratch on full LAFAN+CMU (6,707 clips): 5-step proprioception history + sensor noise + full DR (foot friction, torso CoM, encoder bias, actuator delay, RSI jitter) + reference root linear/angular velocity goal twist + 3-tier whole-body soft-contact BPTT",
  "config": {
    "training": {
      "num_envs": 1536,
      "total_env_steps": 196608000,
      "warmup_steps": 32,
      "updates_per_step": 1,
      "save_every": 16384000,
      "log_every": 25,
      "compile": true,
      "cuda_graphs": true,
      "muon_dtype": "bfloat16",
      "buffer_size": 512
    },
    "motion": {
      "manifest": "${data_root}/outputs/humanoid_light_bfm/manifest.json"
    },
    "environment": {
      "action_mode": "coupled_scale",
      "action_scale": 0.25,
      "key_bodies_only": true,
      "goal_root_twist": true,
      "domain_randomization": {
        "enabled": true,
        "foot_friction_range": [0.4, 1.25],
        "base_com_x_range": [-0.025, 0.025],
        "base_com_y_range": [-0.035, 0.035],
        "base_com_z_range": [-0.035, 0.035],
        "encoder_bias_range": [-0.015, 0.015],
        "actuator_delay_min_lag": 0,
        "actuator_delay_max_lag": 2,
        "actuator_delay_hold_prob": 0.95,
        "actuator_delay_update_period": 8,
        "rsi_pose_xy": 0.03,
        "rsi_pose_z": 0.01,
        "rsi_pose_rp": 0.06,
        "rsi_pose_yaw": 0.15,
        "rsi_joint_pos": 0.05
      },
      "whole_body_contact": {
        "enabled": true,
        "impact_scale": 1.0,
        "slip_scale": 1.0,
        "v_free": 0.18,
        "impact_height": 0.050,
        "impact_tau": 0.012,
        "slip_height": 0.010,
        "slip_tau": 0.004,
        "head_forbid_weight": 400.0,
        "head_safe_height": 0.045,
        "unintended_weight": 150.0,
        "unintended_height": 0.025,
        "ref_air_height": 0.060,
        "ref_air_tau": 0.015,
        "clear_tau": 0.008,
        "extra_action_rate_weight": 0.05
      }
    },
    "runner": {
      "representation": "gencoord",
      "actor_obs": "proprio",
      "history_length": 5,
      "sampling_mode": "return",
      "slot_mix": {
        "motion": 1.0,
        "velocity": 0.0
      },
      "dynamics_hidden_dims": [1024, 1024, 1024],
      "actor_hidden_dims": [1024, 1024, 512, 256],
      "critic_hidden_dims": [512, 256],
      "wm": {
        "num_batches": 2,
        "batch_size": 1536,
        "horizon": 8
      },
      "policy": {
        "lr": 0.0002,
        "num_batches": 1,
        "batch_size": 1536,
        "horizon": 32
      }
    }
  },
  "inputs": []
}
