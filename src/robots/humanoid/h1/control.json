{
  "source": "Unitree unitree_rl_gym H1 PD gains and neutral pose; joint names mapped to the copied LocoMuJoCo MJCF",
  "source_url": "https://github.com/unitreerobotics/unitree_rl_gym/blob/main/legged_gym/envs/h1/h1_config.py",
  "action_mapping": "BFM-Zero: default + 0.25 * clip(raw * 5, -5, 5) * effort_limit / stiffness; clip PD torque, not position targets",
